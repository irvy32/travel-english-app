  "grammar_highlights": [
    {
      "id": "L7-h1",
      "title": "描述問題：I have a problem with... / My... is not working.",
      "description": "打電話給客服時，最直接的開頭就是描述你有什麼問題。用 is not working（不能用）非常清楚。",
      "example_en": "I have a problem with my TV. / My TV is not working.",
      "example_zh": ""
    },
    {
      "id": "L7-h2",
      "title": "接受簡單的故障排除指令",
      "description": "客服人員常會請你做簡單的檢查，如 turn on/off（開/關）、restart（重啟）、check the cable（檢查線）。聽從指示操作。",
      "example_en": "Please turn off the modem and turn it on again.",
      "example_zh": ""
    },
    {
      "id": "L7-h3",
      "title": "準備好帳號資訊",
      "description": "詢問帳單或方案時，客服通常會需要你的帳號（account number）或電話號碼（phone number），最好先準備好。",
      "example_en": "My account number is 123456.",
      "example_zh": ""
    }
  ],
