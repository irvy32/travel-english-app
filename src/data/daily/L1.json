  "grammar_highlights": [
    {
      "id": "L1-h1",
      "title": "簡單介紹自己的句型：I’m from... / I live in...",
      "description": "介紹自己時常用 I’m from + 地點 表示「我來自哪裡」，I live in + 地點 表示「我住在某地」。",
      "example_en": "I’m from Taiwan, and I live in Toronto now.",
      "example_zh": "我來自台灣，現在住在多倫多。"
    },
    {
      "id": "L1-h2",
      "title": "用 Do you...? 開頭的簡單問句",
      "description": "Do you...? 是最常用來問對方基本情況的問句，後面接動詞原形。",
      "example_en": "Do you like cooking?",
      "example_zh": "你喜歡做飯嗎？"
    },
    {
      "id": "L1-h3",
      "title": "用 I like to... / I like... 表達喜好",
      "description": "表達喜歡做某事，可以用 I like to + 動詞原形，或 I like + 動詞-ing。",
      "example_en": "I like to read books. / I like reading books.",
      "example_zh": "我喜歡看書。"
    }
  ],
