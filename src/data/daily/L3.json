  "chapter_id": "L3",
  "chapter_name": "超市與市場購物",
  "description": "在超市或市場買菜、購物。包含：詢問商品在哪裡、重量／數量、價格、是否有特價，找不到東西請店員幫忙。",
  "sentences": [
    {
      "id": "L3-d1",
      "role": "本人",
      "en": "Excuse me, where can I find the milk?",
      "zh": "不好意思，請問牛奶在哪裡？",
      "keywords": [
        {
          "word": "find",
          "kk": "/faɪnd/",
          "zh": "找到"
        }
      ],
      "level": "A2",
      "tags": [
        "禮貌用語",
        "詢問"
      ],
      "tips": "打擾鄰居前說 Sorry to bother you，友善的開場能讓對話更順利。",
      "audio": null
    },
    {
      "id": "L3-d2",
      "role": "店員",
      "en": "The milk is in aisle 3, at the back.",
      "zh": "牛奶在第三走道，後面。",
