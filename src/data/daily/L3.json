  "grammar_highlights": [
    {
      "id": "L3-h1",
      "title": "用 Where can I find...? 或 Where is...? 找東西",
      "description": "在超市找不到東西時，可以這樣問店員。後面直接接你想找的商品名稱。",
      "example_en": "Where can I find the cooking oil?",
      "example_zh": "請問食用油在哪裡？"
    },
    {
      "id": "L3-h2",
      "title": "用 How much is...? 詢問價格",
      "description": "How much is...? 用來問單一物品的價格。如果是複數，用 How much are...?",
      "example_en": "How much is this cheese? / How much are these apples?",
      "example_zh": "這起司多少錢？ / 這些蘋果多少錢？"
    },
    {
      "id": "L3-h3",
      "title": "用 I'd like... / I'll take... 表示要購買",
      "description": "決定要買什麼之後，可以用 I'd like...（我想要...）或 I'll take...（我要買...）告訴店員。",
      "example_en": "I'd like one bag of rice, please.",
      "example_zh": "請給我一袋米。"
    }
  ],
