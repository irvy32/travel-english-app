  "grammar_highlights": [
    {
      "id": "L4-h1",
      "title": "點餐開頭：I'd like to order... for delivery/takeout.",
      "description": "打電話訂餐時，用這個開頭最清楚。說 for delivery 是外送，for takeout 是外帶。",
      "example_en": "I'd like to order a sandwich for takeout.",
      "example_zh": "我想點一個三明治外帶。"
    },
    {
      "id": "L4-h2",
      "title": "用 Please make it... 提出特殊要求",
      "description": "如果有特殊要求（如少鹽、不辣），可以在點餐後用 Please make it... 來表達。",
      "example_en": "Please make it less oily.",
      "example_zh": "請做得少油一點。"
    },
    {
      "id": "L4-h3",
      "title": "提供地址和電話",
      "description": "外送時，對方會詢問地址 (address) 和電話號碼 (phone number)。準備好這兩個資訊。",
      "example_en": "My address is 10 Park Road. My phone is 555-6789.",
      "example_zh": "我的地址是公園路10號。我的電話是555-6789。"
    }
  ],
