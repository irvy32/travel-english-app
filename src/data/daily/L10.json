  "grammar_highlights": [
    {
      "id": "L10-h1",
      "title": "接電話自我介紹：This is [your name] speaking.",
      "description": "接電話時，如果對方沒說要找誰，可以先報上自己的名字，讓對方知道你是誰。",
      "example_en": "Hello, this is John speaking.",
      "example_zh": ""
    },
    {
      "id": "L10-h2",
      "title": "聽不清楚時禮貌請求重複",
      "description": "電話中聽不清楚很常見。用 I'm sorry, could you repeat that?（抱歉，可以重複嗎？）或 Can you speak louder?（可以說大聲點嗎？）來請求幫助。",
      "example_en": "Sorry, the connection is bad. Could you say that again?",
      "example_zh": ""
    },
    {
      "id": "L10-h3",
      "title": "確認約會細節：時間、地點",
      "description": "安排見面時，最後一定要確認時間（time）和地點（place），避免誤會。",
      "example_en": "So, we'll meet at the library at 3 p.m., right?",
      "example_zh": ""
    }
  ],
