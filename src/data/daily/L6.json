  "grammar_highlights": [
    {
      "id": "L6-h1",
      "title": "表達需求：I'd like to... 或 I want to...",
      "description": "在銀行或郵局辦理業務時，用 I'd like to...（我想要...）開頭，比較有禮貌。",
      "example_en": "I'd like to send a letter to Japan.",
      "example_zh": "我想寄一封信到日本。"
    },
    {
      "id": "L6-h2",
      "title": "詢問費用：What is the fee? 或 How much is the postage?",
      "description": "進行交易前，記得詢問手續費（fee）或郵資（postage），避免結帳時才發現太貴。",
      "example_en": "How much is the fee for a wire transfer?",
      "example_zh": "電匯的手續費是多少？"
    },
    {
      "id": "L6-h3",
      "title": "準備好證件與資料",
      "description": "在國外辦銀行業務通常需要護照（passport）和地址證明（proof of address），最好事先準備好。",
      "example_en": "I have my passport and my driver's license.",
      "example_zh": ""
    }
  ],
