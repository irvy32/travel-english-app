  "grammar_highlights": [
    {
      "id": "L5-h1",
      "title": "描述症狀：I have a... 或 My... hurts.",
      "description": "告訴醫生哪裡不舒服，最簡單就是用 I have a...（我有一個...症狀）或 My... hurts.（我的...痛）。",
      "example_en": "I have a fever. / My back hurts.",
      "example_zh": "我發燒。/ 我的背痛。"
    },
    {
      "id": "L5-h2",
      "title": "回答時間長短：Since... 或 ... ago",
      "description": "醫生問症狀多久了，可以用 Since + 開始的時間點（如 yesterday），或用 ... ago（如 two days ago）。",
      "example_en": "Since last night. / Three days ago.",
      "example_zh": "從昨晚開始。/ 三天前開始的。"
    },
    {
      "id": "L5-h3",
      "title": "詢問用藥方法：How many times a day? / When should I take it?",
      "description": "拿到藥後，一定要問清楚一天吃幾次、何時吃、飯前還是飯後吃。",
      "example_en": "How many times a day should I take this medicine?",
      "example_zh": "這個藥我一天要吃幾次？"
    }
  ],
