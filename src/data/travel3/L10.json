    {
      "id": "d1",
      "role": "服務生",
      "en": "Good evening. A table for two?",
      "zh": "晚上好，兩位嗎？",
      "keywords": [
        {
          "word": "evening",
          "kk": "/--/",
          "zh": "（重要單字）"
        },
        {
          "word": "table",
          "kk": "/--/",
          "zh": "（重要單字）"
        }
      ],
      "level": "A2",
      "tags": [
        "服務生",
        "餐廳",
        "超市",
        "購物"
      ],
      "tips": "進入餐廳時，服務生常問人數，「A table for two?」是標準問句，直接回答「Yes, please.」即可。",
      "audio": null
    },
    {
      "id": "d2",
      "role": "旅客",
      "en": "Yes, please.",
      "zh": "是的，麻煩了。",
      "keywords": [],
