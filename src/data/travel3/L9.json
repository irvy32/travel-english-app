  "sentences": [
    {
      "id": "d1",
      "role": "旅客",
      "en": "Excuse me, I'm looking for the Central Park. Is it far from here?",
      "zh": "不好意思，我在找中央公園。它離這裡遠嗎？",
      "keywords": [
        {
          "word": "excuse",
          "kk": "/--/",
          "zh": "（重要單字）"
        },
        {
          "word": "looking",
          "kk": "/--/",
          "zh": "（重要單字）"
        }
      ],
      "level": "A2",
      "tags": [
        "問路",
        "大眾交通",
        "旅客",
        "口語表達"
      ],
      "tips": "「I'm looking for...」是找路或找地方時的開場句，比直接說地點更自然，讓對方知道你需要幫助。",
      "audio": null
    },
    {
      "id": "d2",
      "role": "路人",
      "en": "It's not far. Go straight for two blocks, then turn right. You'll see it.",
      "zh": "不遠。直走兩個街區，然後右轉，你就會看到了。",
      "keywords": [
        {
          "word": "straight",
          "kk": "/--/",
          "zh": "（重要單字）"
        },
        {
          "word": "blocks",
          "kk": "/--/",
          "zh": "（重要單字）"
        }
      ],
      "level": "A2",
      "tags": [
        "路人",
        "問路",
        "大眾交通",
        "街道"
      ],
      "tips": "聽懂指路方向非常重要：straight（直走）、turn right（右轉）、turn left（左轉）、blocks（街區）。",
      "audio": null
    },
    {
      "id": "d3",
      "role": "旅客",
      "en": "Thank you very much.",
      "zh": "非常感謝。",
      "keywords": [],
      "level": "A2",
      "tags": [
        "問路",
        "大眾交通",
        "旅客",
        "口語表達"
      ],
      "tips": "「Thank you very much.」比「Thank you.」更誠摯，對方花時間幫忙時，表達更多感謝更有禮貌。",
      "audio": null
    },
    {
      "id": "d4",
      "role": "旅客",
      "en": "Excuse me, does this bus go to the Art Museum?",
