  "chapter_name": "登機與機上服務",
  "sentences": [
    {
      "id": "d1",
      "role": "空服員",
      "en": "Welcome aboard. Your seat is 24A, on the left.",
      "zh": "歡迎登機。您的座位是24A，在左邊。",
      "keywords": [
        {
          "word": "aboard",
          "kk": "/əˈbɔrd/",
          "zh": "在飛機/船上"
        }
      ],
      "level": "A2",
      "tags": [
        "空服員",
        "登機",
        "機上服務",
        "機上"
      ],
      "tips": "「Welcome aboard.」是空服員歡迎旅客登機的標準用語，aboard表示在交通工具上。",
      "audio": null
    },
    {
      "id": "d2",
      "role": "旅客",
      "en": "Thank you. Can you help me with this bag?",
      "zh": "謝謝。可以幫我放這個包包嗎？",
      "keywords": [
        {
          "word": "help",
          "kk": "/hɛlp/",
          "zh": "幫助、救命"
        }
      ],
      "level": "A2",
      "tags": [
        "登機",
        "機上服務",
        "旅客",
        "口語表達"
      ],
      "tips": "「Can you help me with...?」是禮貌請求幫助的句型，with後接需要協助的事物，語氣親切。",
      "audio": null
    },
    {
      "id": "d3",
      "role": "空服員",
      "en": "Of course. I will put it in the overhead bin.",
      "zh": "當然可以。我會把它放到上方的行李櫃。",
      "keywords": [
        {
          "word": "overhead bin",
          "kk": "/ˌovɚˈhɛd bɪn/",
          "zh": "上方行李櫃"
        }
      ],
      "level": "A2",
      "tags": [
        "空服員",
        "登機",
        "機上服務",
        "機上"
      ],
      "tips": "空服員協助放置行李時會說「I'll put it in the overhead bin.」，overhead bin指座位上方的行李櫃。",
      "audio": null
    },
    {
      "id": "d4",
      "role": "旅客",
      "en": "Excuse me, could I have a blanket, please?",
      "zh": "不好意思，可以給我一條毛毯嗎？",
      "keywords": [
        {
          "word": "blanket",
          "kk": "/ˈblæŋkɪt/",
          "zh": "毛毯"
        }
      ],
      "level": "A2",
      "tags": [
        "登機",
        "機上服務",
        "旅客",
        "口語表達"
      ],
      "tips": "「Excuse me, could I have...?」是在飛機上向空服員要東西的標準句型，語氣有禮貌。",
      "audio": null
    },
