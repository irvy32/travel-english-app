    {
      "id": "d1",
      "role": "旅客",
      "en": "Excuse me, how can I get to the city center?",
      "zh": "不好意思，請問我怎麼去市中心？",
      "keywords": [
        {
          "word": "city center",
          "kk": "/ˈsɪti ˈsɛntɚ/",
          "zh": "市中心"
