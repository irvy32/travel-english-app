    },
    {
      "id": "d9",
      "role": "移民官",
      "en": "Enjoy your stay.",
      "zh": "祝您旅途愉快。",
      "keywords": [
        {
          "word": "enjoy",
          "kk": "/--/",
          "zh": "（重要單字）"
