  "sentences": [
    {
      "id": "d1",
      "role": "旅客",
      "en": "Excuse me, where is Gate B12?",
      "zh": "不好意思，請問B12登機門在哪裡？",
      "keywords": [
        {
          "word": "excuse",
          "kk": "/--/",
          "zh": "（重要單字）"
        }
      ],
      "level": "A2",
      "tags": [
        "候機",
        "免稅店",
        "購物",
        "旅客"
      ],
      "tips": "「Excuse me,」是向陌生人搭話的禮貌開場白，在機場等公共場所問路時必備的起始語。",
      "audio": null
    },
    {
      "id": "d2",
      "role": "機場人員",
      "en": "Go straight, then turn left. It's next to the coffee shop.",
      "zh": "直走，然後左轉。它就在咖啡店旁邊。",
      "keywords": [
        {
          "word": "straight",
          "kk": "/--/",
          "zh": "（重要單字）"
        },
        {
          "word": "coffee",
          "kk": "/--/",
          "zh": "（重要單字）"
        }
      ],
      "level": "A2",
      "tags": [
        "機場人員",
        "候機",
        "免稅店",
        "購物"
      ],
      "tips": "指路時常用「Go straight（直走）」「Turn left/right（左/右轉）」，聽懂這類方向指示非常重要。",
      "audio": null
    },
    {
      "id": "d3",
      "role": "旅客",
      "en": "Thank you.",
      "zh": "謝謝。",
      "keywords": [],
      "level": "A2",
      "tags": [
        "候機",
        "免稅店",
        "購物",
        "旅客"
      ],
      "tips": "「Thank you.」是最基本的感謝語，在服務場合中要養成習慣，有助於建立良好互動。",
      "audio": null
    },
    {
